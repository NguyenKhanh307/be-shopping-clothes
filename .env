SPRING_APPLICATION_NAME=be-shopping-clothes

# Database connection (fill with giá trị thật của bạn)
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/zenis_ecommerce_db?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=

# JPA / Hibernate config
SPRING_JPA_HIBERNATE_DDL_AUTO=update
SPRING_JPA_SHOW_SQL=true

# Server config
SERVER_PORT=8080

FE_IMAGE_DIR=../frontend-client/assets/images/